{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brightloop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brightloop",
      // Replace with the id printed by `npx wrangler d1 create brightloop` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Daily scheduler: billing run, plan auto-close, overdue/dunning, renewals, detection.
  // Free plan allows up to 5 cron triggers per account.
  "triggers": { "crons": ["0 1 * * *"] },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "CURRENCY": "INR",
    "EMAIL_MODE": "outbox"
  }
}
